--- /dev/null
+++ b/kernel/bootwatch.c
@@ -0,0 +1,36 @@
+/*
+ * DEBUG ONLY: catch a boot that never completes.
+ * - 900 s after boot, if still armed: dump all tasks and warm-restart into
+ *   recovery (RAM console survives, readable as /proc/last_kmsg).
+ * - While armed, power-off/halt/reboot requests are logged and redirected to
+ *   a warm restart into recovery.
+ * init disarms it on sys.boot_completed via
+ *   /sys/module/bootwatch/parameters/armed
+ */
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+
+int bootwatch_armed = 1;
+module_param_named(armed, bootwatch_armed, int, 0664);
+
+static void bootwatch_fn(struct work_struct *work)
+{
+	if (!bootwatch_armed)
+		return;
+	pr_emerg("bootwatch: boot not completed after 900 s; dumping tasks\n");
+	show_state_filter(0);
+	pr_emerg("bootwatch: restarting into recovery\n");
+	kernel_restart("recovery");
+}
+static DECLARE_DELAYED_WORK(bootwatch_work, bootwatch_fn);
+
+static int __init bootwatch_init(void)
+{
+	pr_emerg("bootwatch: armed (900 s)\n");
+	schedule_delayed_work(&bootwatch_work, 900 * HZ);
+	return 0;
+}
+late_initcall(bootwatch_init);
