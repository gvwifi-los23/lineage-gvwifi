--- a/kernel/bootwatch.c
+++ b/kernel/bootwatch.c
@@ -12,6 +12,23 @@
 #include <linux/workqueue.h>
 #include <linux/reboot.h>
 #include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/init.h>
+
+/*
+ * Recovery (Samsung bootloader passes bootmode=2) and off-mode charging
+ * (androidboot.mode=charger) never set sys.boot_completed, so the watchdog
+ * must not arm there. Recovery also keeps SELinux permissive (see selinuxfs).
+ */
+bool bootwatch_is_recovery(void)
+{
+	return strstr(saved_command_line, "bootmode=2") != NULL;
+}
+
+static bool bootwatch_is_charger(void)
+{
+	return strstr(saved_command_line, "androidboot.mode=charger") != NULL;
+}
 
 int bootwatch_armed = 1;
 module_param_named(armed, bootwatch_armed, int, 0664);
@@ -29,6 +46,12 @@
 
 static int __init bootwatch_init(void)
 {
+	if (bootwatch_is_recovery() || bootwatch_is_charger()) {
+		bootwatch_armed = 0;
+		pr_info("bootwatch: %s boot, not arming\n",
+			bootwatch_is_recovery() ? "recovery" : "charger");
+		return 0;
+	}
 	pr_emerg("bootwatch: armed (900 s)\n");
 	schedule_delayed_work(&bootwatch_work, 900 * HZ);
 	return 0;
