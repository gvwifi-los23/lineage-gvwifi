         if (checkDefaultAttribute && !imi.isDefault(context)) {
             return false;
         }
+        // gvwifi: a default system IME whose XML subtypes name no language (HeliBoard declares
+        // one locale-less placeholder and adds its languages at runtime) could never match the
+        // system locale, so first boot always fell back to another keyboard. Count it as
