+    private static boolean hasOnlyLocaleLessSubtypes(InputMethodInfo imi,
+            String requiredSubtypeMode) {
+        boolean modeFound = false;
+        final int count = imi.getSubtypeCount();
+        for (int i = 0; i < count; ++i) {
+            final InputMethodSubtype subtype = imi.getSubtypeAt(i);
+            if (!TextUtils.isEmpty(subtype.getLocale())
+                    || !TextUtils.isEmpty(subtype.getLanguageTag())) {
+                return false;
+            }
+            // Same mode test as SubtypeUtils.containsSubtypeOf() (SUBTYPE_MODE_ANY is null).
+            if (TextUtils.isEmpty(requiredSubtypeMode)
+                    || requiredSubtypeMode.equalsIgnoreCase(subtype.getMode())) {
+                modeFound = true;
+            }
+        }
+        return count == 0 || modeFound;
+    }
