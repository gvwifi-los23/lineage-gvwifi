         }
     }
 
-    if (isAtLeast26Q2) {
+    // gvwifi: on the 3.10 kernel's BPF backport this self test is advisory: a
+    // failure is logged instead of failing init (which aborts netd1shot and
+    // reboots with reboot,netd1shot-fail).
+    if (isAtLeast26Q2) if (auto st = [&]() -> Result<void> {
         // Simple boot time self test that verifies that loopback ip/tcp works
         // (this triggers at least bpf cgroup inet_create/ingress/egress/inet_release hooks)
 
@@ -457,6 +475,11 @@ Result<void> BpfHandler::init(const char* cg2_path) {
         if (rcv != snd) return Error() << "wrong";
 
         // all 3 sockets are closed automatically
+        return {};
+    }(); !st.ok()) {
+        std::string msg = "loopback self test failed (ignored): " + st.error().message();
+        ALOGW("%s", msg.c_str());
+        kmsgLog(msg);
     }
 
     return {};
