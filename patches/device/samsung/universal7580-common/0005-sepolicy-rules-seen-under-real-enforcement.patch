--- a/sepolicy/vendor_init.te
+++ b/sepolicy/vendor_init.te
@@ -31,3 +31,6 @@
 # init.target.rc sets ro.vendor.hwc.present_fence_reliable
 set_prop(vendor_init, vendor_gvwifi_hwc_prop)
 dontaudit vendor_init rootfs:dir read;
+
+# Samsung rc mkdir/chown under /data (wifi, app, radio, nfc)
+allow vendor_init { wifi_data_file apk_data_file radio_core_data_file nfc_data_file }:dir search;
--- a/sepolicy/gpsd.te
+++ b/sepolicy/gpsd.te
@@ -65,3 +65,6 @@
 
 # GPS assistance data over the network
 allow gpsd netd:unix_stream_socket connectto;
+
+# gpsd probes per-user app data dirs; nothing there it needs
+dontaudit gpsd system_data_file:dir search;
--- a/sepolicy/vendor_toolbox.te
+++ b/sepolicy/vendor_toolbox.te
@@ -44,3 +44,5 @@
 }:file { r_file_perms setattr };
 
 allow vendor_toolbox vendor_toolbox:capability dac_override;
+# init.baseband.rc strips security.sehash from /efs dirs so restorecon relabels
+allow vendor_toolbox self:capability sys_admin;
--- a/sepolicy/tee.te
+++ b/sepolicy/tee.te
@@ -7,3 +7,5 @@
 
 # sys.mobicore.enable
 set_prop(tee, tee_prop)
+
+dontaudit tee apk_data_file:dir search;
