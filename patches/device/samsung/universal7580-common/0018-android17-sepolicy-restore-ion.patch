diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 422c186..41e6813 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -193,3 +193,7 @@
 
 # gralloc is loaded by cameraserver/apps via the mapper passthrough
 /(vendor|system/vendor)/lib(64)?/hw/gralloc\.exynos5\.so u:object_r:same_process_hal_file:s0
+
+# Android 17 dropped ION from platform policy (DMA-BUF heaps replace it), but
+# kernel 3.10 only has ION: the Exynos gralloc allocates every buffer from /dev/ion.
+/dev/ion                                            u:object_r:ion_device:s0
diff --git a/sepolicy/ion.te b/sepolicy/ion.te
new file mode 100644
index 0000000..dab5c4e
--- /dev/null
+++ b/sepolicy/ion.te
@@ -0,0 +1,3 @@
+# Android 17 dropped ION from platform policy; restore the pre-DMA-BUF-heap rule
+# (AOSP domain.te) so gralloc can allocate and map buffers on kernel 3.10.
+allow domain ion_device:chr_file r_file_perms;
