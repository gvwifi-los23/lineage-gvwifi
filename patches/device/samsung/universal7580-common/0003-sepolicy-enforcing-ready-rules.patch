From: gvwifi-los23 build kit
Subject: [PATCH] universal7580: SELinux rules from permissive feature run (health sysfs, gralloc same-process, build props, camera/HWC legacy props, gpsd/netd, vendor_init cpufreq)

---
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index a4a150f..d9edf3d 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -188,3 +188,6 @@
 /(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator-service\.universal7580  u:object_r:hal_vibrator_default_exec:s0
 # ODM config inside /system/vendor/odm
 /system/vendor/odm/etc(/.*)?  u:object_r:vendor_configs_file:s0
+
+# gralloc is loaded by cameraserver/apps via the mapper passthrough
+/(vendor|system/vendor)/lib(64)?/hw/gralloc\.exynos5\.so u:object_r:same_process_hal_file:s0
diff --git a/sepolicy/genfs_contexts b/sepolicy/genfs_contexts
index c889e68..e1c4241 100644
--- a/sepolicy/genfs_contexts
+++ b/sepolicy/genfs_contexts
@@ -126,3 +126,6 @@ genfscon sysfs /devices/14800000.dsim      u:object_r:sysfs_graphics:s0
 
 # video4linux
 genfscon sysfs /devices/12800000.mfc0/video4linux   u:object_r:sysfs_v4l:s0
+
+# gvwifi bq24773 charger power_supply (read by the health HAL)
+genfscon sysfs /devices/13890000.hsi2c/i2c-1/1-006a/power_supply u:object_r:sysfs_usb_supply:s0
diff --git a/sepolicy/gpsd.te b/sepolicy/gpsd.te
index e03117e..33547ee 100644
--- a/sepolicy/gpsd.te
+++ b/sepolicy/gpsd.te
@@ -62,3 +62,6 @@ allow gpsd radio_prop:file { getattr open read };
 allow gpsd servicemanager:binder call;
 allow gpsd system_data_file:lnk_file read;
 allow gpsd system_file:file { getattr open read };
+
+# GPS assistance data over the network
+allow gpsd netd:unix_stream_socket connectto;
diff --git a/sepolicy/hal_camera_default.te b/sepolicy/hal_camera_default.te
index 38fa4e4..1869f9c 100644
--- a/sepolicy/hal_camera_default.te
+++ b/sepolicy/hal_camera_default.te
@@ -4,3 +4,7 @@ allow hal_camera_default sysfs_camera:file rw_file_perms;
 allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
 
 vndbinder_use(hal_camera_default)
+
+# legacy Samsung camera HAL reads unlabeled props (ro.build.PDA, sys.cameramode.*, ...)
+get_prop(hal_camera_default, default_prop)
+allow hal_camera_default hal_graphics_allocator_service:service_manager find;
diff --git a/sepolicy/hal_graphics_composer.te b/sepolicy/hal_graphics_composer.te
index efcef17..6c0e90d 100644
--- a/sepolicy/hal_graphics_composer.te
+++ b/sepolicy/hal_graphics_composer.te
@@ -16,3 +16,6 @@ allow hal_graphics_composer_default secmem_device:chr_file rw_file_perms;
 allow hal_graphics_composer_default hal_graphics_allocator_service:service_manager find;
 
 get_prop(hal_graphics_composer_default, vendor_gvwifi_hwc_prop)
+
+# legacy Exynos HWC reads unlabeled props
+get_prop(hal_graphics_composer_default, default_prop)
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index b7fbf17..b9bf5d9 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -27,3 +27,8 @@ persist.sys.swapoff     u:object_r:sswap_prop:s0
 
 # Display: HWC1 retire fences are valid present fences
 ro.vendor.hwc.present_fence_reliable u:object_r:vendor_gvwifi_hwc_prop:s0 exact bool
+
+# Build props set by init_gvwifi / odm build.prop: readable by all, like their AOSP siblings
+ro.vendor.product.          u:object_r:build_vendor_prop:s0 prefix
+ro.vendor.build.version.    u:object_r:build_vendor_prop:s0 prefix
+ro.vendor_dlkm.build.       u:object_r:build_vendor_prop:s0 prefix
diff --git a/sepolicy/vendor_init.te b/sepolicy/vendor_init.te
index c5c9459..aba5b53 100644
--- a/sepolicy/vendor_init.te
+++ b/sepolicy/vendor_init.te
@@ -24,3 +24,6 @@ allow vendor_init wpa_socket:dir getattr;
 # init.target.rc low-RAM tuning
 allow vendor_init proc_vm:file w_file_perms;
 allow vendor_init proc_extra_free_kbytes:file w_file_perms;
+
+# init.target.rc CPU governor tuning
+allow vendor_init sysfs_devices_system_cpu:file w_file_perms;
